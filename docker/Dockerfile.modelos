# ==============================================================================
# Multi-stage Dockerfile para Microservicio de Modelos Predictivos (FastAPI)
# Inferencia en produccion: SARIMA e Inferencia de Clasificador de Morosidad
# ==============================================================================

# STAGE 1: Builder
FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# STAGE 2: Runtime Final
FROM python:3.11-slim AS runner

WORKDIR /app

RUN groupadd -g 1001 appgroup && \
    useradd -u 1001 -g appgroup -s /bin/bash -m appuser

COPY --from=builder /root/.local /home/appuser/.local

# Copiar codigo fuente y modelos entrenados
COPY services/modelos ./services/modelos
COPY services/modelos_api ./services/modelos_api
COPY clean ./clean
COPY models ./models

ENV PATH=/home/appuser/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8001

USER appuser

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/health')" || exit 1

CMD ["uvicorn", "services.modelos_api.main:app", "--host", "0.0.0.0", "--port", "8001"]
